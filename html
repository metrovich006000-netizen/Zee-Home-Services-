  <script>
    'use strict';

    const BUSINESS_EMAIL = 'zeehomservices@zeehomeservices.com';

    const tabIds = {
      home: 'tab-home-content',
      handyman: 'tab-handyman-content',
      turnover: 'tab-turnover-content',
      calculator: 'tab-calculator-content'
    };

    const tabButtonIds = {
      home: 'btn-home',
      handyman: 'btn-handyman',
      turnover: 'btn-turnover',
      calculator: 'btn-calculator'
    };

    // Cart data lives in memory for this page session.
    // Prices are estimates for the listed scope.
    let cart = [];

    function switchTab(tab) {
      if (!Object.prototype.hasOwnProperty.call(tabIds, tab)) return;

      Object.entries(tabIds).forEach(([key, id]) => {
        document.getElementById(id).classList.toggle('hidden', key !== tab);
      });

      Object.entries(tabButtonIds).forEach(([key, id]) => {
        const button = document.getElementById(id);
        const active = key === tab;

        button.classList.toggle('active', active);
        button.classList.toggle('text-slate-300', !active);
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function formatMoney(value) {
      return '$' + Number(value).toLocaleString('en-US', {
        maximumFractionDigits: 2
      });
    }

    function getCartTotals() {
      return cart.reduce((totals, item) => {
        totals.count += item.qty;
        totals.price += item.price * item.qty;
        return totals;
      }, { count: 0, price: 0 });
    }

    function addToCart(title, price, cardId) {
      const existing = cart.find(item => item.title === title);

      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({
          title: String(title),
          price: Number(price),
          qty: 1
        });
      }

      updateCartUI();
      animateAddToCart(cardId);
      showCartFeedback(title);
    }

    function animateAddToCart(cardId) {
      const card = document.getElementById(cardId);
      const target = document.querySelector('#cart-badge');

      if (!card || !target || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      const from = card.getBoundingClientRect();
      const to = target.getBoundingClientRect();

      const flyer = document.createElement('div');
      flyer.className = 'flying-item w-11 h-11 rounded-full bg-mint text-navy shadow-xl flex items-center justify-center';
      flyer.innerHTML = '<i class="fa-solid fa-basket-shopping"></i>';

      flyer.style.left = (from.left + from.width / 2 - 22) + 'px';
      flyer.style.top = (from.top + Math.min(from.height / 2, 150) - 22) + 'px';

      document.body.appendChild(flyer);

      // Force layout so the browser registers the initial position.
      flyer.getBoundingClientRect();

      const dx = to.left + to.width / 2 - (from.left + from.width / 2);
      const dy = to.top + to.height / 2 - (from.top + Math.min(from.height / 2, 150));

      flyer.style.transform = `translate(${dx}px, ${dy}px) scale(.25)`;
      flyer.style.opacity = '0.1';

      window.setTimeout(() => flyer.remove(), 750);
    }

    let feedbackTimeout;

    function showCartFeedback(title) {
      const badge = document.getElementById('cart-badge');
      badge.title = title + ' added to order';

      badge.classList.add('ring-4', 'ring-mint/30');

      window.clearTimeout(feedbackTimeout);
      feedbackTimeout = window.setTimeout(() => {
        badge.classList.remove('ring-4', 'ring-mint/30');
      }, 450);
    }

    function removeFromCart(index) {
      if (index < 0 || index >= cart.length) return;

      cart.splice(index, 1);
      updateCartUI();
    }

    function changeQty(index, delta) {
      if (!cart[index]) return;

      cart[index].qty += delta;

      if (cart[index].qty <= 0) {
        cart.splice(index, 1);
      }

      updateCartUI();
    }

    function updateCartUI() {
      const container = document.getElementById('cart-items-container');
      const badge = document.getElementById('cart-badge');
      const stickyBar = document.getElementById('sticky-cart-bar');
      const totals = getCartTotals();

      badge.textContent = totals.count;
      document.getElementById('sticky-item-count').textContent = totals.count;
      document.getElementById('sticky-total-price').textContent = formatMoney(totals.price);
      document.getElementById('drawer-total-price').textContent = formatMoney(totals.price);

      stickyBar.classList.toggle('translate-y-full', totals.count === 0);

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="text-center py-12 text-slate-400">
            <i class="fa-solid fa-basket-shopping text-4xl mb-4"></i>
            <p>Your request is currently empty.</p>
            <p class="text-xs mt-2">Add a service to get started.</p>
          </div>
        `;
      } else {
        container.replaceChildren();

        cart.forEach((item, index) => {
          const row = document.createElement('div');
          row.className = 'rounded-xl border border-slate-200 bg-surface p-4';

          const top = document.createElement('div');
          top.className = 'flex items-start justify-between gap-3';

          const info = document.createElement('div');
          info.className = 'min-w-0';

          const title = document.createElement('p');
          title.className = 'font-extrabold text-sm text-navy break-words';
          title.textContent = item.title;

          const price = document.createElement('p');
          price.className = 'text-xs text-mint-deep font-semibold mt-2';
          price.textContent = `${formatMoney(item.price)} × ${item.qty} = ${formatMoney(item.price * item.qty)}`;

          info.append(title, price);

          const remove = document.createElement('button');
          remove.className = 'text-slate-400 hover:text-red-600 p-2 rounded-lg shrink-0';
          remove.type = 'button';
          remove.setAttribute('aria-label', 'Remove ' + item.title);
          remove.innerHTML = '<i class="fa-solid fa-trash"></i>';
          remove.addEventListener('click', () => removeFromCart(index));

          top.append(info, remove);

          const controls = document.createElement('div');
          controls.className = 'flex items-center justify-between mt-4 pt-3 border-t border-slate-200';

          const quantityLabel = document.createElement('span');
          quantityLabel.className = 'text-xs text-slate-500';
          quantityLabel.textContent = 'Quantity';

          const quantityControls = document.createElement('div');
          quantityControls.className = 'flex items-center gap-3';

          const minus = document.createElement('button');
          minus.type = 'button';
          minus.className = 'w-9 h-9 rounded-lg bg-white border border-slate-200 font-bold hover:bg-slate-100';
          minus.textContent = '−';
          minus.setAttribute('aria-label', 'Decrease quantity');
          minus.addEventListener('click', () => changeQty(index, -1));

          const qty = document.createElement('span');
          qty.className = 'font-extrabold text-navy min-w-4 text-center';
          qty.textContent = item.qty;

          const plus = document.createElement('button');
          plus.type = 'button';
          plus.className = 'w-9 h-9 rounded-lg bg-white border border-slate-200 font-bold hover:bg-slate-100';
          plus.textContent = '+';
          plus.setAttribute('aria-label', 'Increase quantity');
          plus.addEventListener('click', () => changeQty(index, 1));

          quantityControls.append(minus, qty, plus);
          controls.append(quantityLabel, quantityControls);
          row.append(top, controls);
          container.appendChild(row);
        });
      }

      updateEmailLink();
    }

    function updateEmailLink() {
      const button = document.getElementById('btn-email-order');
      const totals = getCartTotals();
      const notes = document.getElementById('customer-notes').value.trim();

      const subject = 'Service Request - Zee Home Services LLC';

      const lines = [
        'Hello Zee Home Services LLC,',
        '',
        'I would like to request a quote for the following services:',
        ''
      ];

      if (cart.length === 0) {
        lines.push('No services selected yet.');
      } else {
        cart.forEach(item => {
          lines.push(
            `${item.title} — ${item.qty} × ${formatMoney(item.price)} = ${formatMoney(item.price * item.qty)}`
          );
        });
      }

      lines.push('');
      lines.push('Estimated Total: ' + formatMoney(totals.price));
      lines.push('');
      lines.push('Please contact me to confirm availability, scope, and the final price.');

      if (notes) {
        lines.push('');
        lines.push('Project Notes:');
        lines.push(notes);
      }

      lines.push('');
      lines.push('Name:');
      lines.push('Property Address:');
      lines.push('Preferred Contact / Schedule:');

      const body = lines.join('\n');

      button.href =
        'mailto:' + BUSINESS_EMAIL +
        '?subject=' + encodeURIComponent(subject) +
        '&body=' + encodeURIComponent(body);
    }

    function openCart() {
      const modal = document.getElementById('cart-modal');
      const panel = document.getElementById('cart-panel');

      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('cart-open');

      updateEmailLink();

      requestAnimationFrame(() => {
        panel.classList.remove('translate-x-full');
      });

      const closeButton = modal.querySelector('button[aria-label="Close cart"]');
      if (closeButton) closeButton.focus();
    }

    function closeCart() {
      const modal = document.getElementById('cart-modal');
      const panel = document.getElementById('cart-panel');

      panel.classList.add('translate-x-full');
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('cart-open');

      window.setTimeout(() => {
        if (modal.getAttribute('aria-hidden') === 'true') {
          modal.classList.add('hidden');
        }
      }, 320);
    }

    function calcTotal() {
      const items = document.querySelectorAll('.calc-item');
      let total = 0;
      let count = 0;

      items.forEach(item => {
        if (item.checked) {
          total += Number(item.value);
          count += 1;
        }
      });

      document.getElementById('calc-result').textContent = formatMoney(total);
      document.getElementById('calc-count').textContent =
        count + (count === 1 ? ' service selected' : ' services selected');

      document.querySelectorAll('.calc-row').forEach(row => {
        const checkbox = row.querySelector('.calc-item');
        row.classList.toggle('border-mint-deep', checkbox.checked);
        row.classList.toggle('bg-mint-bg', checkbox.checked);
      });

      return { total, count };
    }

    function addCalculatorSelection() {
      const checked = Array.from(document.querySelectorAll('.calc-item:checked'));

      if (checked.length === 0) {
        alert('Please select at least one service first.');
        return;
      }

      checked.forEach(input => {
        addToCart(input.dataset.title, Number(input.value), 'tab-calculator-content');
      });

      openCart();
    }

    function clearCalculator() {
      document.querySelectorAll('.calc-item').forEach(input => {
        input.checked = false;
      });

      calcTotal();
    }

    // Refresh the email link when project notes change.
    document.getElementById('customer-notes').addEventListener('input', updateEmailLink);

    // Close drawer with Escape.
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        const modal = document.getElementById('cart-modal');
        if (!modal.classList.contains('hidden')) closeCart();
      }
    });

    // Update the copyright year automatically.
    document.getElementById('copyright-year').textContent = new Date().getFullYear();

    // Initialize UI.
    updateCartUI();
    calcTotal();
  </script>

</body>
</html>